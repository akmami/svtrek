SNP_PER_KB=1.0                 # SNPs per kb

# SV insertions/deletions (SURVIVOR "INDEL": ins+del combined)
# Set INDEL_MIN=1 to also include short indels in this same rate/range.
INDEL_PER_MB=8                 # SV in/del events per Mb
INDEL_MIN=50
INDEL_MAX=10000

# tandem duplications
DUP_PER_MB=0.7
DUP_MIN=200
DUP_MAX=10000
DUP_MAX_COPIES=3

# inversions
INV_PER_MB=0.1
INV_MIN=200
INV_MAX=8000

# translocations (set rate 0 to disable)
TRA_PER_MB=0
TRA_MIN=1000
TRA_MAX=5000

# inverted deletions / inverted duplications
INVDEL_PER_MB=0
INVDEL_MIN=100
INVDEL_MAX=2000
INVDUP_PER_MB=0
INVDUP_MIN=100
INVDUP_MAX=2000

# zygosity
HOM_RATIO=0.5                  # fraction of variants homozygous
N_HAPLOID=1

# read model (Badread) + mapping
DEPTH=30                       # default coverage (overridable with -d)
READ_MEAN_LEN=15000
READ_SD_LEN=4000
READ_IDENTITY=99.5,100,0.5     # PacBio CLR ~ 87.5,97.5,5
MINIMAP_PRESET=map-hifi        # map-hifi | map-pb | map-ont
